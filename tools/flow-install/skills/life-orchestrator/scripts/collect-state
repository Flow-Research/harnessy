#!/usr/bin/env python3
"""
collect-state — Scan all project state and produce JSON to stdout.

The "cheap detector": answers "did anything change?" not "what does it mean?"
Runs from project root (auto-detected via git or cwd).
"""

import argparse
import datetime
import hashlib
import json
import os
import re
import subprocess
import sys

# ── Paths ────────────────────────────────────────────────────────────────────

def detect_project_root():
    """Resolve the active Harnessy project root.

    Installed global skill scripts live under `~/.agents/skills`, so deriving the
    project root from `__file__` points at the global skill directory rather than
    the repo the scheduler `cd`'d into. Prefer an explicit env var, then the
    current working tree, and only fall back to the current directory.
    """
    env_root = os.environ.get("FLOW_PROJECT_ROOT")
    if env_root:
        return env_root

    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=5, cwd=os.getcwd(),
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass

    return os.getcwd()


PROJECT_ROOT = detect_project_root()

_USERNAME = os.environ.get("FLOW_USER", os.environ.get("USER", "default"))
PRIVATE_DIR = os.path.join(PROJECT_ROOT, ".jarvis", "context", "private", _USERNAME)
DOCS_DIR = os.path.join(PROJECT_ROOT, ".jarvis", "context", "docs")
PROJECTS_DIR = os.path.join(PROJECT_ROOT, "projects")
GOAL_AGENT_DIR = os.path.join(PROJECT_ROOT, ".goal-agent")
AUTOFLOW_STATE = os.path.join(PROJECT_ROOT, ".jarvis", "context", "autoflow", "state.json")
CRON_YAML = os.path.join(PROJECT_ROOT, ".jarvis", "cron.yaml")
JARVIS_PLANS = os.path.expanduser("~/.jarvis/plans")
JARVIS_WIKIS = os.path.expanduser("~/.jarvis/wikis")
AGENTS_LIFE_DIR = os.path.expanduser(os.environ.get("AGENTS_LIFE_DIR", "~/.agents/life"))
LIFE_PRIORITIES_FILE = os.path.expanduser(
    os.environ.get("LIFE_PRIORITIES_FILE", os.path.join(AGENTS_LIFE_DIR, "priorities.md"))
)
LAST_CRAWL = os.path.join(AGENTS_LIFE_DIR, ".last-crawl.json")
NOTES_DIR = os.path.join(PRIVATE_DIR, "notes")


# ── Helpers ──────────────────────────────────────────────────────────────────

def read_file(path):
    """Read file contents, return None if missing."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except (OSError, IOError):
        return None


def read_json(path):
    """Read and parse a JSON file, return None if missing or invalid."""
    text = read_file(path)
    if text is None:
        return None
    try:
        return json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return None


def file_modified_iso(path):
    try:
        return datetime.datetime.fromtimestamp(
            os.path.getmtime(path),
            tz=datetime.timezone.utc,
        ).isoformat()
    except OSError:
        return None


def file_hash(text):
    if text is None:
        return None
    return hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest()


def run_cmd(args, cwd=None):
    """Run a command, return stdout or None on failure."""
    try:
        result = subprocess.run(
            args,
            capture_output=True, text=True, timeout=10,
            cwd=cwd or PROJECT_ROOT,
        )
        if result.returncode == 0:
            return result.stdout.strip()
        return None
    except (OSError, subprocess.TimeoutExpired):
        return None


def scan_dir(dirpath):
    """Walk a directory and return list of relative file paths + metadata."""
    files = []
    newest = 0.0
    if not os.path.isdir(dirpath):
        return files, newest
    for root, _dirs, filenames in os.walk(dirpath):
        for fname in filenames:
            if fname.startswith("."):
                continue
            full = os.path.join(root, fname)
            try:
                mtime = os.path.getmtime(full)
            except OSError:
                mtime = 0.0
            rel = os.path.relpath(full, dirpath)
            files.append({"path": rel, "modified": datetime.datetime.fromtimestamp(mtime, tz=datetime.timezone.utc).isoformat()})
            if mtime > newest:
                newest = mtime
    return files, newest


# ── Section collectors ───────────────────────────────────────────────────────

def collect_priorities():
    """Parse priorities.md — extract table rows, constraints, personal notes."""
    priorities_path = os.path.join(PRIVATE_DIR, "priorities.md")
    text = read_file(priorities_path)
    if text is None:
        return None

    external_text = read_file(LIFE_PRIORITIES_FILE)
    result = {
        "raw": text,
        "source_path": os.path.relpath(priorities_path, PROJECT_ROOT),
        "source_modified": file_modified_iso(priorities_path),
        "external_path": LIFE_PRIORITIES_FILE,
        "external_exists": external_text is not None,
        "external_modified": file_modified_iso(LIFE_PRIORITIES_FILE),
        "external_differs": external_text is not None and file_hash(external_text) != file_hash(text),
        "external_older": False,
        "table": [],
        "constraints": [],
        "personal": [],
        "standing_instructions": [],
    }
    if result["external_modified"] and result["source_modified"]:
        result["external_older"] = result["external_modified"] < result["source_modified"]

    # Extract markdown table rows (skip header + separator)
    in_table = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("| Project") or stripped.startswith("|---"):
            in_table = True
            continue
        if in_table and stripped.startswith("|"):
            cells = [c.strip() for c in stripped.strip("|").split("|")]
            if len(cells) >= 4:
                result["table"].append({
                    "project": cells[0],
                    "priority": cells[1],
                    "status": cells[2],
                    "next_milestone": cells[3],
                })
        elif in_table and not stripped.startswith("|"):
            in_table = False

    # Extract bullet sections by heading
    current_section = None
    for line in text.splitlines():
        heading_match = re.match(r"^##\s+(.+)", line)
        if heading_match:
            heading = heading_match.group(1).strip().lower()
            if "constraint" in heading:
                current_section = "constraints"
            elif "personal" in heading:
                current_section = "personal"
            elif "standing" in heading:
                current_section = "standing_instructions"
            else:
                current_section = None
            continue
        if current_section and line.strip().startswith("- "):
            result[current_section].append(line.strip()[2:])

    return result


def collect_projects():
    """Auto-discover project directories under the private context folder.

    Any subdirectory (not starting with . or _) is treated as a project.
    Description is pulled from status.md first line if present, else the dirname.
    No hardcoded project list — private context stays private.
    """
    projects = {}

    if os.path.isdir(PRIVATE_DIR):
        for entry in sorted(os.listdir(PRIVATE_DIR)):
            if entry.startswith((".","_")) or not os.path.isdir(os.path.join(PRIVATE_DIR, entry)):
                continue
            # Skip known non-project dirs
            if entry == "notes":
                continue

            dirpath = os.path.join(PRIVATE_DIR, entry)
            files, newest = scan_dir(dirpath)
            status_md = read_file(os.path.join(dirpath, "status.md"))

            # Extract description from status.md first heading, or use dirname
            description = entry
            if status_md:
                for line in status_md.splitlines():
                    if line.startswith("# "):
                        description = line[2:].strip()
                        break

            projects[entry] = {
                "description": description,
                "file_count": len(files),
                "newest_modified": datetime.datetime.fromtimestamp(newest, tz=datetime.timezone.utc).isoformat() if newest > 0 else None,
                "status_md": status_md,
                "files": files,
            }

    # Also include standalone files in private dir
    for fname in ("decisions.md", "events.md", "facts.md", "preferences.md"):
        content = read_file(os.path.join(PRIVATE_DIR, fname))
        if content is not None:
            projects[f"_private/{fname}"] = {"content": content}

    # Docs directory
    docs_files, docs_newest = scan_dir(DOCS_DIR)
    if docs_files:
        projects["_docs"] = {
            "file_count": len(docs_files),
            "newest_modified": datetime.datetime.fromtimestamp(docs_newest, tz=datetime.timezone.utc).isoformat() if docs_newest > 0 else None,
            "files": docs_files,
        }

    return projects


def discover_project_context_vaults():
    """Find nested Harnessy/Jarvis context vaults under projects/*."""
    vaults = []
    seen = set()
    if not os.path.isdir(PROJECTS_DIR):
        return vaults

    try:
        project_entries = sorted(os.listdir(PROJECTS_DIR))
    except OSError:
        return vaults

    for slug in project_entries:
        if slug.startswith("."):
            continue
        project_root = os.path.join(PROJECTS_DIR, slug)
        if not os.path.isdir(project_root):
            continue

        for context_path in (
            os.path.join(project_root, "dev", ".jarvis", "context"),
            os.path.join(project_root, ".jarvis", "context"),
        ):
            if not os.path.isdir(context_path):
                continue
            realpath = os.path.realpath(context_path)
            if realpath in seen:
                continue
            seen.add(realpath)
            vaults.append(
                {
                    "project": slug,
                    "path": context_path,
                    "relative_path": os.path.relpath(context_path, PROJECT_ROOT),
                }
            )

    return vaults


def collect_project_context_vaults():
    """Collect compact state from nested project .jarvis/context vaults."""
    vaults = {}
    lookback_days = int(os.environ.get("LIFE_ORCHESTRATOR_MEETING_LOOKBACK_DAYS", "5"))
    meeting_limit = int(os.environ.get("LIFE_ORCHESTRATOR_VAULT_MEETINGS_LIMIT", "5"))
    today = datetime.date.today()
    cutoff = today - datetime.timedelta(days=max(lookback_days - 1, 0))

    for vault in discover_project_context_vaults():
        context_path = vault["path"]
        files, newest = scan_dir(context_path)
        project = vault["project"]
        vaults[project] = {
            "project": project,
            "path": vault["relative_path"],
            "file_count": len(files),
            "newest_modified": (
                datetime.datetime.fromtimestamp(newest, tz=datetime.timezone.utc).isoformat()
                if newest > 0
                else None
            ),
            "status_md": read_file(os.path.join(context_path, "status.md")),
            "roadmap_md": read_file(os.path.join(context_path, "roadmap.md")),
            "decisions_md": read_file(os.path.join(context_path, "decisions.md")),
            "recent_meetings": _collect_meetings_under(
                context_path,
                cutoff=cutoff,
                default_project=project,
                limit=meeting_limit,
            ),
        }

    return vaults


def collect_git():
    """Recent commits, current branch, uncommitted changes."""
    return {
        "branch": run_cmd(["git", "branch", "--show-current"]),
        "recent_commits": (run_cmd(["git", "log", "--since=7 days ago", "--oneline", "-n", "30"]) or "").splitlines(),
        "uncommitted": (run_cmd(["git", "status", "--short"]) or "").splitlines(),
    }


def collect_agents():
    """Goal-agent run states from .goal-agent/*/state.json."""
    agents = {}
    if not os.path.isdir(GOAL_AGENT_DIR):
        return agents
    try:
        for entry in os.listdir(GOAL_AGENT_DIR):
            state_path = os.path.join(GOAL_AGENT_DIR, entry, "state.json")
            state = read_json(state_path)
            if state is not None:
                agents[entry] = state
    except OSError:
        pass

    # Autoflow state
    autoflow = read_json(AUTOFLOW_STATE)
    if autoflow is not None:
        agents["_autoflow"] = autoflow

    return agents


def collect_tmux():
    """Active tmux sessions."""
    output = run_cmd(["tmux", "list-sessions"])
    if output is None:
        return []
    return output.splitlines()


def collect_cron():
    """Contents of .jarvis/cron.yaml."""
    return read_file(CRON_YAML)


def collect_notes():
    """Read recent daily notes from private/notes/."""
    lookback_days = int(os.environ.get("LIFE_ORCHESTRATOR_NOTES_LOOKBACK_DAYS", "5"))
    today = datetime.date.today()
    notes = {}

    for offset in range(max(lookback_days, 0)):
        day = today - datetime.timedelta(days=offset)
        year = day.strftime("%Y")
        month = day.strftime("%b")
        dd = day.strftime("%d")
        path = os.path.join(NOTES_DIR, year, month, f"{dd}.md")
        content = read_file(path)
        if content is not None:
            notes[day.isoformat()] = content

    return notes if notes else None


def collect_recent_meetings():
    """Read compact summaries for recent root and project-vault meeting notes.

    Meeting folders can contain full transcripts and long Fathom summaries. The
    daily brief only needs enough signal to notice new decisions and action
    items, so keep this date-bounded and section-based.
    """
    lookback_days = int(os.environ.get("LIFE_ORCHESTRATOR_MEETING_LOOKBACK_DAYS", "5"))
    limit = int(os.environ.get("LIFE_ORCHESTRATOR_RECENT_MEETINGS_LIMIT", "12"))
    today = datetime.date.today()
    cutoff = today - datetime.timedelta(days=max(lookback_days - 1, 0))
    meetings = []

    if os.path.isdir(PRIVATE_DIR):
        meetings.extend(
            _collect_meetings_under(
                PRIVATE_DIR,
                cutoff=cutoff,
                default_project="",
                limit=None,
            )
        )

    for vault in discover_project_context_vaults():
        meetings.extend(
            _collect_meetings_under(
                vault["path"],
                cutoff=cutoff,
                default_project=vault["project"],
                limit=None,
            )
        )

    deduped = {}
    for meeting in meetings:
        deduped[meeting["path"]] = meeting

    meetings = list(deduped.values())
    meetings.sort(key=lambda item: (item["date"], item["path"]), reverse=True)
    return meetings[:limit]


def _collect_meetings_under(context_root, cutoff, default_project="", limit=None):
    meetings = []
    for root, _dirs, filenames in os.walk(context_root):
        rel_root = os.path.relpath(root, context_root)
        if "meetings" not in rel_root.split(os.sep):
            continue
        for fname in filenames:
            if not fname.endswith(".md") or fname.startswith("."):
                continue
            path = os.path.join(root, fname)
            text = read_file(path) or ""
            meeting_date = _extract_meeting_date(text, path)
            if meeting_date < cutoff:
                continue
            rel_path = os.path.relpath(path, PROJECT_ROOT)
            project = _extract_meeting_project(text, path, context_root, default_project)
            meetings.append(
                {
                    "date": meeting_date.isoformat(),
                    "project": project,
                    "title": _extract_markdown_title(text) or os.path.splitext(fname)[0],
                    "source_ref": _extract_metadata_value(text, "Source Ref"),
                    "path": rel_path,
                    "summary": _compact_text(
                        _extract_first_section(
                            text,
                            (
                                "Executive Summary",
                                "One-Line Summary",
                                "Summary",
                                "Key Takeaways",
                                "Meeting Purpose",
                            ),
                        ),
                        max_chars=1200,
                    ),
                    "action_items": _extract_bullets_from_sections(
                        text,
                        ("Action Items", "Next Steps", "Concrete Follow-Ups", "Action Checklist"),
                        max_items=8,
                    ),
                }
            )

    meetings.sort(key=lambda item: (item["date"], item["path"]), reverse=True)
    if limit is not None:
        return meetings[:limit]
    return meetings


def _extract_markdown_title(text):
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def _extract_metadata_value(text, key):
    key_re = re.escape(key)
    patterns = (
        rf"^\s*-\s*{key_re}:\s*(.+?)\s*$",
        rf"^\s*\*\*{key_re}:\*\*\s*(.+?)\s*$",
    )
    for line in text.splitlines()[:80]:
        for pattern in patterns:
            match = re.match(pattern, line)
            if match:
                return match.group(1).strip()
    return ""


def _extract_meeting_project(text, path, context_root, default_project=""):
    metadata_project = _extract_metadata_value(text, "Project")
    if metadata_project:
        return metadata_project
    try:
        parts = os.path.relpath(path, context_root).split(os.sep)
    except ValueError:
        return default_project
    if len(parts) > 1 and parts[0] != "meetings" and parts[1] == "meetings":
        return parts[0]
    return default_project


def _extract_meeting_date(text, path):
    raw = _extract_metadata_value(text, "Date")
    if raw:
        try:
            return datetime.date.fromisoformat(raw[:10])
        except ValueError:
            pass
    try:
        return datetime.datetime.fromtimestamp(os.path.getmtime(path)).date()
    except OSError:
        return datetime.date.today()


def _extract_first_section(text, headings):
    for heading in headings:
        section = _extract_markdown_section(text, heading)
        if section:
            return section
    return ""


def _extract_markdown_section(text, heading):
    pattern = re.compile(rf"^##+\s+{re.escape(heading)}\s*$", re.MULTILINE)
    match = pattern.search(text)
    if not match:
        return ""
    start = match.end()
    next_heading = re.search(r"^##\s+", text[start:], flags=re.MULTILINE)
    end = start + next_heading.start() if next_heading else len(text)
    return text[start:end].strip()


def _extract_bullets_from_sections(text, headings, max_items=8):
    bullets = []
    seen = set()
    for heading in headings:
        section = _extract_markdown_section(text, heading)
        for line in section.splitlines():
            stripped = line.strip()
            if stripped.startswith(("- ", "* ")):
                bullet = _clean_markdown_inline(stripped[2:].strip())
                key = re.sub(r"\s+", " ", bullet).lower()
                if not bullet or key in seen:
                    continue
                seen.add(key)
                bullets.append(bullet)
                if len(bullets) >= max_items:
                    return bullets
    return bullets


def _compact_text(text, max_chars=1200):
    lines = [line.rstrip() for line in text.splitlines() if line.strip()]
    compact = _clean_markdown_inline("\n".join(lines))
    if len(compact) <= max_chars:
        return compact
    return compact[: max_chars - 3].rstrip() + "..."


def _clean_markdown_inline(text):
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = text.replace("**", "")
    text = text.replace("\\~", "~")
    text = re.sub(r"^\[[ xX]\]\s+", "", text)
    return text.strip()


def collect_wiki_updates():
    """Scan ~/.jarvis/wikis/*/ for recent autonomous-research activity.

    Reads each domain's `wiki/log.md` for entries in the last 24 hours, the
    most recent findings files in `.state/findings/`, and the pending seed
    queue. The morning brief surfaces this so the user sees what their research
    agents found overnight.
    """
    if not os.path.isdir(JARVIS_WIKIS):
        return None

    cutoff = datetime.datetime.now() - datetime.timedelta(hours=24)
    log_ts_re = re.compile(r"^\[(\d{4}-\d{2}-\d{2}) (\d{2}):(\d{2})\]")
    domains = {}
    total_pending = 0
    total_recent_sessions = 0

    for entry in sorted(os.listdir(JARVIS_WIKIS)):
        domain_root = os.path.join(JARVIS_WIKIS, entry)
        if not os.path.isdir(domain_root):
            continue
        wiki_dir = os.path.join(domain_root, "wiki")
        if not os.path.isdir(wiki_dir):
            continue

        # Title from schema.yaml (best-effort, no yaml dep available here)
        title = entry
        schema_text = read_file(os.path.join(domain_root, "schema.yaml")) or ""
        for line in schema_text.splitlines():
            line = line.strip()
            if line.startswith("title:"):
                title = line.split(":", 1)[1].strip().strip("'\"")
                break

        # Recent log entries (within last 24h)
        log_text = read_file(os.path.join(wiki_dir, "log.md")) or ""
        recent_entries = []
        for line in log_text.splitlines():
            m = log_ts_re.match(line.strip())
            if not m:
                continue
            try:
                entry_dt = datetime.datetime.strptime(
                    f"{m.group(1)} {m.group(2)}:{m.group(3)}",
                    "%Y-%m-%d %H:%M",
                )
            except ValueError:
                continue
            if entry_dt >= cutoff:
                recent_entries.append(line.strip())

        # Recent findings files (read frontmatter for structured fields)
        findings_dir = os.path.join(domain_root, ".state", "findings")
        recent_findings = []
        if os.path.isdir(findings_dir):
            files = sorted(
                (f for f in os.listdir(findings_dir) if f.endswith(".md")),
                reverse=True,
            )[:5]
            for f in files:
                fp = os.path.join(findings_dir, f)
                if os.path.getmtime(fp) < cutoff.timestamp():
                    continue
                fm = _parse_simple_frontmatter(read_file(fp) or "")
                recent_findings.append(
                    {
                        "file": f,
                        "session_id": fm.get("session_id"),
                        "topic": fm.get("topic"),
                        "files_created": fm.get("files_created"),
                        "errors": fm.get("errors"),
                    }
                )
                total_recent_sessions += 1

        # Pending seed count from seeds.md
        pending_count = _count_pending_seeds(
            read_file(os.path.join(domain_root, "seeds.md")) or ""
        )
        total_pending += pending_count

        # Active topics from program.md (just the bullet names, best-effort)
        active_topics = _extract_active_topics(
            read_file(os.path.join(domain_root, "program.md")) or ""
        )

        # Skip domains with nothing to report
        if not recent_entries and not recent_findings and pending_count == 0:
            continue

        domains[entry] = {
            "title": title,
            "pending_seeds": pending_count,
            "recent_log_entries": recent_entries[-10:],  # most recent 10
            "recent_findings": recent_findings,
            "active_topics": active_topics,
        }

    if not domains:
        return None
    return {
        "domains": domains,
        "total_pending_seeds": total_pending,
        "total_recent_sessions": total_recent_sessions,
    }


def _parse_simple_frontmatter(text):
    """Parse top YAML frontmatter as a flat dict (no yaml dep)."""
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end == -1:
        return {}
    block = text[3:end]
    out = {}
    for line in block.splitlines():
        if ":" in line:
            k, _, v = line.partition(":")
            out[k.strip()] = v.strip()
    return out


def _count_pending_seeds(text):
    """Count `### ` headings inside the `## Pending` section of a seeds.md file."""
    if "## Pending" not in text:
        return 0
    pending_start = text.find("## Pending")
    processed_start = text.find("## Processed", pending_start)
    section = text[pending_start:processed_start] if processed_start != -1 else text[pending_start:]
    return sum(1 for line in section.splitlines() if line.startswith("### "))


def _extract_active_topics(text):
    """Extract bullet names from the `## Active Topics` section of program.md."""
    if "## Active Topics" not in text:
        return []
    start = text.find("## Active Topics")
    # Find the next H2 header
    next_h2 = text.find("\n## ", start + 4)
    section = text[start:next_h2] if next_h2 != -1 else text[start:]
    # Strip HTML comments
    section = re.sub(r"<!--.*?-->", "", section, flags=re.DOTALL)
    topics = []
    for line in section.splitlines():
        stripped = line.strip()
        if stripped.startswith(("- ", "* ")):
            # Take everything before the first " —" or " -" qualifier
            name = re.split(r"\s+[—-]\s+", stripped[2:].strip(), maxsplit=1)[0]
            if name:
                topics.append(name.strip())
    return topics[:10]


def collect_jarvis_plans():
    """Find latest plan from ~/.jarvis/plans/."""
    if not os.path.isdir(JARVIS_PLANS):
        return None
    try:
        md_files = [
            f for f in os.listdir(JARVIS_PLANS)
            if f.endswith(".md") and not f.startswith(".")
        ]
        if not md_files:
            return None
        # Sort by mtime, newest first
        md_files.sort(
            key=lambda f: os.path.getmtime(os.path.join(JARVIS_PLANS, f)),
            reverse=True,
        )
        latest = md_files[0]
        content = read_file(os.path.join(JARVIS_PLANS, latest))
        return {"file": latest, "content": content}
    except OSError:
        return None


# ── Change detection ─────────────────────────────────────────────────────────

def compute_hash(state):
    """Hash the state dict (excluding volatile fields) for change detection."""
    hashable = {k: v for k, v in state.items() if k not in ("changed", "timestamp")}
    raw = json.dumps(hashable, sort_keys=True, default=str)
    return hashlib.sha256(raw.encode()).hexdigest()


def check_changed(current_hash):
    """Compare against last crawl. Returns True if changed or no prior crawl."""
    last = read_json(LAST_CRAWL)
    if last is None:
        return True
    return last.get("hash") != current_hash


def save_crawl(current_hash):
    """Persist current hash for next comparison."""
    crawl_dir = os.path.dirname(LAST_CRAWL)
    try:
        os.makedirs(crawl_dir, exist_ok=True)
        with open(LAST_CRAWL, "w") as f:
            json.dump({
                "hash": current_hash,
                "timestamp": datetime.datetime.now(tz=datetime.timezone.utc).isoformat(),
            }, f)
    except OSError as e:
        print(f"Warning: could not save crawl state: {e}", file=sys.stderr)


# ── Main ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="Collect state across all projects — answers 'did anything change?'"
    )
    parser.add_argument(
        "--no-save", action="store_true",
        help="Don't update .last-crawl.json (dry run)"
    )
    args = parser.parse_args()

    state = {
        "priorities": collect_priorities(),
        "projects": collect_projects(),
        "project_context_vaults": collect_project_context_vaults(),
        "notes": collect_notes(),
        "recent_meetings": collect_recent_meetings(),
        "git": collect_git(),
        "agents": collect_agents(),
        "tmux_sessions": collect_tmux(),
        "cron": collect_cron(),
        "jarvis": collect_jarvis_plans(),
        "wiki_updates": collect_wiki_updates(),
        "timestamp": datetime.datetime.now(tz=datetime.timezone.utc).isoformat(),
    }

    current_hash = compute_hash(state)
    state["changed"] = check_changed(current_hash)

    json.dump(state, sys.stdout, indent=2, default=str)
    sys.stdout.write("\n")

    if not args.no_save:
        save_crawl(current_hash)


if __name__ == "__main__":
    main()
