#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME=$(basename "$0")

usage() {
  cat <<'EOF'
Usage:
  tmux-agent-launcher --runner <claude|opencode|codex> [session-name] [options] [-- <runner-args>...]
  tmux-agent-launcher attach <session-name> [--dry-run] [--json]
  tmux-agent-launcher list [--json]

Launch Claude, OpenCode, or Codex in a named tmux session, attach to an existing session, or list sessions.

Options:
  --runner <name>   Runner to launch: claude, opencode, or codex
  --cwd <path>      Working directory for the tmux session (default: current directory)
  --permission-mode <mode>
                    Permission behavior: bypass or default (default: user config, then bypass)
  --skip-permissions
                    Shortcut for --permission-mode bypass
  --no-skip-permissions
                    Shortcut for --permission-mode default
  --attach          Attach to the session after creating it (default)
  --no-attach       Leave the session detached after creating it
  --dry-run         Print the launch plan without creating a tmux session
  --json            Emit machine-readable JSON
  --help            Show this help text
  -- <args>...      Pass remaining arguments to the runner command
EOF
}

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

fail() {
  local code="$1"
  local message="$2"
  if [[ "$JSON_MODE" == "1" ]]; then
    printf '{"ok":false,"error":{"code":%s,"message":%s}}\n' "$code" "$(json_escape "$message")"
  else
    printf '%s: %s\n' "$SCRIPT_NAME" "$message" >&2
  fi
  exit "$code"
}

require_command() {
  local command_name="$1"
  command -v "$command_name" >/dev/null 2>&1 || fail 3 "Missing required command: $command_name"
}

resolve_config_path() {
  if [[ -n "${TMUX_AGENT_LAUNCHER_CONFIG:-}" ]]; then
    printf '%s\n' "$TMUX_AGENT_LAUNCHER_CONFIG"
    return
  fi

  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    printf '%s\n' "$XDG_CONFIG_HOME/harnessy/tmux-agent-launcher.json"
    return
  fi

  printf '%s\n' "${HOME:-}/.config/harnessy/tmux-agent-launcher.json"
}

read_config_permission_mode() {
  local config_path="$1"
  python3 - "$config_path" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception:
    sys.exit(10)

value = data.get("permissionMode", data.get("permission_mode", ""))
if value is None:
    value = ""
print(str(value).strip())
PY
}

normalize_permission_mode() {
  local raw="$1"
  local normalized
  normalized=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')

  case "$normalized" in
    bypass|skip|skip-permissions|skip_permissions|danger|dangerous)
      printf 'bypass\n'
      ;;
    default|normal|prompt|prompts|ask|manual|none|off)
      printf 'default\n'
      ;;
    *)
      fail 2 "Unsupported permission mode: $raw"
      ;;
  esac
}

runner_has_permission_arg() {
  local arg
  for arg in "${RUNNER_ARGS[@]-}"; do
    case "$RUNNER" in
      claude)
        case "$arg" in
          --permission-mode|--permission-mode=*|--dangerously-skip-permissions|--allow-dangerously-skip-permissions)
            return 0
            ;;
        esac
        ;;
      codex)
        case "$arg" in
          --dangerously-bypass-approvals-and-sandbox|--sandbox|--sandbox=*|-s|--ask-for-approval|--ask-for-approval=*|-a)
            return 0
            ;;
        esac
        ;;
      opencode)
        case "$arg" in
          --dangerously-skip-permissions)
            return 0
            ;;
        esac
        ;;
    esac
  done
  return 1
}

append_shell_args() {
  local arg
  for arg in "$@"; do
    [[ -n "$arg" ]] || continue
    RUNNER_COMMAND+=" $(printf '%q' "$arg")"
  done
}

sanitize_auto_session_segment() {
  local raw="$1"
  python3 - "$raw" <<'PY'
import re
import sys

value = sys.argv[1].strip()
value = re.sub(r"[^A-Za-z0-9_.-]+", "-", value)
value = re.sub(r"-{2,}", "-", value)
value = value.strip("-")
print(value)
PY
}

next_auto_session_index() {
  local prefix="$1"
  local session_lines=""

  if command -v tmux >/dev/null 2>&1; then
    session_lines=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
  fi

  python3 - "$prefix" "$session_lines" <<'PY'
import re
import sys

prefix = sys.argv[1]
sessions = sys.argv[2].splitlines()
pattern = re.compile(r"^" + re.escape(prefix) + r"-(\d+)$")
max_index = 0

for session in sessions:
    match = pattern.match(session)
    if match:
        max_index = max(max_index, int(match.group(1)))

print(max_index + 1)
PY
}

resolve_auto_session_name() {
  local abs_cwd="$1"
  local runner="$2"
  local default_name
  local requested_name
  local normalized_name
  local prefix
  local next_index

  default_name=$(basename "$abs_cwd")
  requested_name="$default_name"

  if [[ -t 0 ]]; then
    printf 'Name [%s]: ' "$default_name" >&2
    IFS= read -r requested_name || requested_name=""
    if [[ -z "$requested_name" ]]; then
      requested_name="$default_name"
    fi
  fi

  normalized_name=$(sanitize_auto_session_segment "$requested_name")
  [[ -n "$normalized_name" ]] || fail 2 "Auto session name is empty after normalization"

  prefix="$normalized_name-$runner"
  next_index=$(next_auto_session_index "$prefix")
  printf '%s-%s\n' "$prefix" "$next_index"
}

RUNNER=""
CWD=$(pwd)
ATTACH=1
DRY_RUN=0
JSON_MODE=0
SESSION_NAME=""
MODE="launch"
PERMISSION_MODE=""
PERMISSION_MODE_SOURCE=""
RUNNER_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    list)
      [[ -z "$SESSION_NAME" && "$RUNNER" == "" ]] || fail 2 "list must be the first argument"
      MODE="list"
      shift
      ;;
    attach)
      [[ -z "$SESSION_NAME" && "$RUNNER" == "" ]] || fail 2 "attach must be the first argument"
      MODE="attach"
      shift
      ;;
    --runner)
      [[ $# -ge 2 ]] || fail 2 "--runner requires a value"
      RUNNER="$2"
      shift 2
      ;;
    --cwd)
      [[ $# -ge 2 ]] || fail 2 "--cwd requires a value"
      CWD="$2"
      shift 2
      ;;
    --permission-mode)
      [[ $# -ge 2 ]] || fail 2 "--permission-mode requires a value"
      PERMISSION_MODE="$2"
      PERMISSION_MODE_SOURCE="cli"
      shift 2
      ;;
    --skip-permissions)
      PERMISSION_MODE="bypass"
      PERMISSION_MODE_SOURCE="cli"
      shift
      ;;
    --no-skip-permissions|--no-permission-bypass)
      PERMISSION_MODE="default"
      PERMISSION_MODE_SOURCE="cli"
      shift
      ;;
    --attach)
      ATTACH=1
      shift
      ;;
    --no-attach)
      ATTACH=0
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --json)
      JSON_MODE=1
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    --)
      shift
      RUNNER_ARGS=("$@")
      break
      ;;
    --*)
      fail 2 "Unknown option: $1"
      ;;
    *)
      if [[ -z "$SESSION_NAME" ]]; then
        SESSION_NAME="$1"
        shift
      else
        fail 2 "Unexpected argument: $1"
      fi
      ;;
  esac
done

if [[ "$MODE" == "list" ]]; then
  require_command tmux
  SESSION_LINES=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
  if [[ "$JSON_MODE" == "1" ]]; then
    SESSION_JSON=$(python3 - <<'PY' "$SESSION_LINES"
import json
import sys
raw = sys.argv[1]
sessions = [line for line in raw.splitlines() if line]
print(json.dumps(sessions))
PY
)
    printf '{"ok":true,"action":"list","sessions":%s}\n' "$SESSION_JSON"
  else
    if [[ -n "$SESSION_LINES" ]]; then
      printf '%s\n' "$SESSION_LINES"
    else
      printf 'No tmux sessions found\n'
    fi
  fi
  exit 0
fi

if [[ "$MODE" == "attach" ]]; then
  [[ -n "$SESSION_NAME" ]] || fail 2 "session name is required"
  require_command tmux

  if [[ "$DRY_RUN" == "0" ]]; then
    tmux has-session -t "$SESSION_NAME" >/dev/null 2>&1 || fail 4 "tmux session does not exist: $SESSION_NAME"
    exec tmux attach-session -t "$SESSION_NAME"
  fi

  if [[ "$JSON_MODE" == "1" ]]; then
    printf '{"ok":true,"action":"attach","session":%s,"dry_run":true,"command":["tmux","attach-session","-t",%s]}\n' \
      "$(json_escape "$SESSION_NAME")" \
      "$(json_escape "$SESSION_NAME")"
  else
    printf 'Dry run: would attach to tmux session %s\n' "$SESSION_NAME"
  fi
  exit 0
fi

if [[ -z "$RUNNER" && -z "$SESSION_NAME" ]]; then
  fail 2 "session name is required"
fi

[[ -n "$RUNNER" ]] || fail 2 "--runner is required"

case "$RUNNER" in
  claude)
    RUNNER_COMMAND=${TMUX_AGENT_LAUNCHER_CLAUDE_CMD:-claude}
    ;;
  opencode)
    RUNNER_COMMAND=${TMUX_AGENT_LAUNCHER_OPENCODE_CMD:-opencode}
    ;;
  codex)
    RUNNER_COMMAND=${TMUX_AGENT_LAUNCHER_CODEX_CMD:-codex}
    ;;
  *)
    fail 2 "Unsupported runner: $RUNNER"
    ;;
esac

RUNNER_BASE_COMMAND="$RUNNER_COMMAND"

require_command python3

if [[ ! -d "$CWD" ]]; then
  fail 2 "Working directory does not exist: $CWD"
fi

ABS_CWD=$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$CWD")

if [[ -z "$SESSION_NAME" ]]; then
  SESSION_NAME=$(resolve_auto_session_name "$ABS_CWD" "$RUNNER")
fi

if [[ -z "$PERMISSION_MODE" && -n "${TMUX_AGENT_LAUNCHER_PERMISSION_MODE:-}" ]]; then
  PERMISSION_MODE="$TMUX_AGENT_LAUNCHER_PERMISSION_MODE"
  PERMISSION_MODE_SOURCE="env"
fi

CONFIG_PATH=$(resolve_config_path)
if [[ -z "$PERMISSION_MODE" && -f "$CONFIG_PATH" ]]; then
  if ! CONFIG_PERMISSION_MODE=$(read_config_permission_mode "$CONFIG_PATH"); then
    fail 2 "Invalid tmux-agent-launcher config: $CONFIG_PATH"
  fi
  if [[ -n "$CONFIG_PERMISSION_MODE" ]]; then
    PERMISSION_MODE="$CONFIG_PERMISSION_MODE"
    PERMISSION_MODE_SOURCE="config"
  fi
fi

if [[ -z "$PERMISSION_MODE" ]]; then
  PERMISSION_MODE="bypass"
  PERMISSION_MODE_SOURCE="built-in"
fi

PERMISSION_MODE=$(normalize_permission_mode "$PERMISSION_MODE")

INJECTED_RUNNER_ARGS=()
if [[ "$PERMISSION_MODE" == "bypass" ]]; then
  if [[ "$RUNNER" == "opencode" && "$RUNNER_COMMAND" != *" "* && "${RUNNER_COMMAND##*/}" == "opencode" ]]; then
    RUNNER_COMMAND+=" run --interactive"
  fi

  if ! runner_has_permission_arg; then
    case "$RUNNER" in
      claude)
        INJECTED_RUNNER_ARGS=(--permission-mode bypassPermissions)
        ;;
      codex)
        INJECTED_RUNNER_ARGS=(--dangerously-bypass-approvals-and-sandbox)
        ;;
      opencode)
        INJECTED_RUNNER_ARGS=(--dangerously-skip-permissions)
        ;;
    esac
  fi
fi

if [[ "$RUNNER" == "opencode" ]]; then
  HAS_LOG_LEVEL=0
  for arg in "${RUNNER_ARGS[@]-}"; do
    [[ -n "$arg" ]] || continue
    if [[ "$arg" == "--log-level" || "$arg" == --log-level=* ]]; then
      HAS_LOG_LEVEL=1
      break
    fi
  done
  if [[ "$HAS_LOG_LEVEL" == "0" ]]; then
    RUNNER_COMMAND+=" --log-level WARN"
  fi
fi

# Append injected args first, then runner args (everything after --), with proper shell escaping.
append_shell_args "${INJECTED_RUNNER_ARGS[@]-}"
append_shell_args "${RUNNER_ARGS[@]-}"

TMUX_COMMAND=(tmux new-session -d -s "$SESSION_NAME" -c "$ABS_CWD" bash -lc "$RUNNER_COMMAND")

if [[ "$JSON_MODE" == "1" ]]; then
  COMMAND_JSON=$(python3 - <<'PY' "$SESSION_NAME" "$ABS_CWD" "$RUNNER_COMMAND"
import json
import sys
session, cwd, runner_command = sys.argv[1:4]
print(json.dumps(["tmux", "new-session", "-d", "-s", session, "-c", cwd, "bash", "-lc", runner_command]))
PY
)
fi

if [[ "$DRY_RUN" == "0" ]]; then
  require_command tmux
  command -v "$RUNNER_BASE_COMMAND" >/dev/null 2>&1 || fail 3 "Missing runner command: $RUNNER_BASE_COMMAND"
  if tmux has-session -t "$SESSION_NAME" >/dev/null 2>&1; then
    fail 4 "tmux session already exists: $SESSION_NAME"
  fi
  "${TMUX_COMMAND[@]}"
  if [[ "$ATTACH" == "1" ]]; then
    exec tmux attach-session -t "$SESSION_NAME"
  fi
fi

if [[ "$JSON_MODE" == "1" ]]; then
  printf '{"ok":true,"action":"launch","runner":%s,"session":%s,"cwd":%s,"permission_mode":%s,"permission_mode_source":%s,"attach":%s,"dry_run":%s,"command":%s}\n' \
    "$(json_escape "$RUNNER")" \
    "$(json_escape "$SESSION_NAME")" \
    "$(json_escape "$ABS_CWD")" \
    "$(json_escape "$PERMISSION_MODE")" \
    "$(json_escape "$PERMISSION_MODE_SOURCE")" \
    "$([[ "$ATTACH" == "1" ]] && printf 'true' || printf 'false')" \
    "$([[ "$DRY_RUN" == "1" ]] && printf 'true' || printf 'false')" \
    "$COMMAND_JSON"
else
  if [[ "$DRY_RUN" == "1" ]]; then
    printf 'Dry run: would launch %s in tmux session %s at %s (permission_mode=%s, attach=%s)\n' "$RUNNER" "$SESSION_NAME" "$ABS_CWD" "$PERMISSION_MODE" "$ATTACH"
  else
    printf 'Launched %s in tmux session %s at %s\n' "$RUNNER" "$SESSION_NAME" "$ABS_CWD"
  fi
fi
